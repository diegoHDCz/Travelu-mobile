TEAM_ID=

PRODUCT_NAME=Travelu
PRODUCT_BUNDLE_IDENTIFIER=br.com.travelu.Travelu$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// API_BASE_URL: default de dev (simulador compartilha a rede do Mac).
// Em xcconfig `//` inicia comentário, por isso o `/$()/` no lugar de `//`.
API_BASE_URL = http:/$()/localhost:8080

// Override local gerado a partir do `.env` por scripts/generate-ios-env.sh
// (gitignored; `#include?` não falha se o arquivo não existir).
#include? "Env.xcconfig"
